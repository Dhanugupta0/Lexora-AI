POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora_secret
POSTGRES_DB=lexora

DATABASE_URL=postgresql://lexora:lexora_secret@postgres:5432/lexora

CHROMA_PATH=/data/chroma
CHROMA_COLLECTION=lexora_chunks

UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=50
MAX_DOCUMENTS=20

EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
DEFAULT_TOP_K=5
