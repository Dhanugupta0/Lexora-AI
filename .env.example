# ════════════════════════════════════════════════════════════════════════════════
#  LexoraAI — Environment Configuration
#  Copy this file to .env and fill in your values before running docker-compose.
# ════════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=LexoraAI
APP_VERSION=1.0.0
DEBUG=false

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora_secret
POSTGRES_DB=lexora
DATABASE_URL=postgresql+asyncpg://lexora:lexora_secret@postgres:5432/lexora
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql+psycopg2://lexora:lexora_secret@postgres:5432/lexora

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=lexora_chunks

# ── File storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=50
MAX_DOCUMENTS=20

# ── Embedding provider: "openai" | "huggingface" ──────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_HF=all-MiniLM-L6-v2

# ── LLM provider: "openai" | "gemini" ─────────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI (required when EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-1.5-flash

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# ── Retrieval ──────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
