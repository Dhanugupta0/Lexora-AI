# ============================ LexoraAI configuration ==========================
# Copy to .env and fill in GROQ_API_KEY + JINA_API_KEY. Everything else has a
# working default.

# --- storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./local_data/lexora.db
CHROMA_PATH=./local_data/chroma
CHROMA_COLLECTION=lexora_chunks
UPLOAD_DIR=./local_data/uploads
MAX_FILE_SIZE_MB=50
MAX_DOCUMENTS=20

# --- LLM (Groq) --------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
# Tried in order when the primary model errors or rate-limits.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=1800
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=45

# --- embeddings (Jina AI -- Groq has no embeddings API) ----------------------
# jina      = hosted jina-embeddings-v4  (recommended; nothing to download)
# fastembed = local ONNX bge-small       (offline fallback, ~130 MB)
# chroma    = bundled MiniLM             (last resort, no extra install)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v4
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=8192

# Get a free key at https://jina.ai/embeddings
JINA_API_KEY=jina_...
JINA_EMBED_MODEL=jina-embeddings-v4
# v4 is Matryoshka-trained: 2048 is the full vector, and any shorter prefix is
# still a valid embedding. 1024 halves the index for ~1% of retrieval quality.
JINA_EMBED_DIMENSIONS=1024
JINA_TIMEOUT_SECONDS=60
JINA_MAX_RETRIES=3

# --- chunking ----------------------------------------------------------------
CHUNK_STRATEGY=semantic
CHUNK_SIZE_TOKENS=420
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=48
SEMANTIC_BREAKPOINT_PERCENTILE=88
CONTEXTUAL_HEADERS=True

# --- retrieval ---------------------------------------------------------------
RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=6
CANDIDATE_POOL=40
RRF_K=60
MMR_ENABLED=True
MMR_LAMBDA=0.65
MIN_RELEVANCE=0.15

# --- reranking ---------------------------------------------------------------
# llm = no extra RAM (recommended on small instances)
# cross_encoder = fully offline, needs ~90 MB more RAM
RERANKER_MODE=llm
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_INPUT_SIZE=20

# --- reasoning ---------------------------------------------------------------
ENABLE_QUERY_PLANNING=True
ENABLE_HYDE=True
MAX_SUB_QUERIES=3
MAX_HISTORY_TURNS=6

# --- grounding ---------------------------------------------------------------
ENABLE_GROUNDING_CHECK=True
GROUNDING_MIN_SUPPORT=0.42
ABSTAIN_THRESHOLD=0.25
STRIP_INVALID_CITATIONS=True

# --- docker-compose postgres -------------------------------------------------
POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora_secret
POSTGRES_DB=lexora
