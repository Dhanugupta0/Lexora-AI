# ── Environment & Secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Virtual Environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python Cache ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Distribution / Build ───────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Testing & Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.coveragerc

# ── Uploads (raw document files) ──────────────────────────────────────────────
uploads/

# ── Database files ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Alembic generated (keep versions/ but ignore local state) ─────────────────
alembic/versions/__pycache__/

# ── IDE & Editor ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Docker volumes (if materialised locally) ──────────────────────────────────
postgres_data/
chroma_data/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Misc ───────────────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.hypothesis/
